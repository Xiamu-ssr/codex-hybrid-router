{
  "$schema": "https://raw.githubusercontent.com/Xiamu-ssr/codex-hybrid-router/main/config.schema.json",
  "version": 1,
  "external_provider": {
    "name": "ZenMux",
    "base_url": "https://zenmux.ai/api/v1",
    "anthropic_base_url": "https://zenmux.ai/api/anthropic",
    "api_key_env": "ZENMUX_API_KEY",
    "keychain_service": "dev.codex-hybrid-router.zenmux",
    "send_authorization": true,
    "send_x_api_key": true,
    "headers": {}
  },
  "external_models": {
    "zenmux/claude-opus-5": {
      "upstream_model": "claude-opus-5",
      "compatibility": "claude",
      "api_protocol": "anthropic_messages",
      "prompt_cache": { "enabled": true, "ttl": "5m" },
      "display_name": "Claude Opus 5 · ZenMux",
      "description": "Claude Opus 5 through ZenMux.",
      "context_window": 512000,
      "max_context_window": 1000000,
      "auto_compact_token_limit": 478000,
      "default_reasoning_level": "max",
      "disable_apply_patch_tool": true,
      "reasoning_levels": ["low", "medium", "high", "xhigh", "max"]
    },
    "zenmux/kimi-k3": {
      "upstream_model": "kimi-k3",
      "compatibility": "kimi",
      "display_name": "Kimi K3 · ZenMux",
      "description": "Kimi K3 through ZenMux.",
      "context_window": 512000,
      "max_context_window": 1048576,
      "auto_compact_token_limit": 478000,
      "default_reasoning_level": "max",
      "disable_apply_patch_tool": true,
      "reasoning_levels": ["low", "medium", "high", "xhigh", "max"]
    },
    "zenmux/grok-4.6": {
      "upstream_model": "grok-4.6",
      "compatibility": "grok",
      "display_name": "Grok 4.6 · ZenMux",
      "description": "Grok 4.6 through ZenMux.",
      "context_window": 500000,
      "max_context_window": 500000,
      "auto_compact_token_limit": 478000,
      "default_reasoning_level": "high",
      "disable_apply_patch_tool": true,
      "reasoning_levels": ["low", "medium", "high"]
    }
  },
  "hybrid_final_models": {
    "hybrid/gpt-5.6-sol-claude-final": {
      "agent_model": "gpt-5.6-sol",
      "agent_service_tier": "priority",
      "finalizer_model": "claude-opus-5",
      "finalizer_compatibility": "claude",
      "display_name": "GPT-5.6 Sol · Claude Final",
      "description": "GPT-5.6 Sol runs tools; Claude Opus 5 audits the complete context and Sol draft before writing the final answer.",
      "context_window": 300000,
      "max_context_window": 300000,
      "auto_compact_token_limit": 268000
    }
  }
}
